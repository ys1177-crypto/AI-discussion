  '<li>비관론과 낙관론은 서로 반대인가, 아니면 다른 시기·영역을 말하고 있는가?</li>'+
  '<li>저확률·고영향 위험에 현재 사회적 자원을 투입하는 것은 정당한가?</li>'+
  '<li>각자의 전공 분야와 희망 진로는 사분면의 어느 영역에 위치하는가?</li>'+
  '<li>AI가 창출하는 이익과 비용은 어떻게 배분되어야 공정한가?</li></ol>'+
  '<label class="field"><span>토론 메모</span><textarea rows="4" data-bind="discussNote">'+esc(S.discussNote)+'</textarea></label></div>';
};

R.reflect = function(){
  var r = S.reflect;
  function ta(key,q){ return '<label class="field"><span>'+q+'</span><textarea rows="2" data-bind="reflect.'+key+'">'+esc(r[key])+'</textarea></label>'; }
  function rg(key,q){ return '<label class="field"><span>'+q+'</span><div class="range"><span class="counter">비관 1</span><input type="range" min="1" max="10" value="'+r[key]+'" data-bind="reflect.'+key+'" data-num="1"><span class="counter">10 낙관</span><output id="o-'+key+'">'+r[key]+'</output></div></label>'; }
  return head("7. 개인 성찰", "활동 전후의 입장 변화와 그 근거를 정리합니다.")+
