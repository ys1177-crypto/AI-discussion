function quadSvg(){
  var X0=70,Y0=20,W=440,cell=W/5;
  var col = getComputedStyle(document.documentElement);
  var doom = col.getPropertyValue("--doom").trim()||"#c8455b", hope = col.getPropertyValue("--hope").trim()||"#c98a00";
  var line = col.getPropertyValue("--line").trim()||"#ddd", muted = col.getPropertyValue("--muted").trim()||"#666", ink = col.getPropertyValue("--ink").trim()||"#000";
  var s = '<svg class="quad" viewBox="0 0 540 540" role="img" aria-label="가능성과 영향력 사분면">';
  // quadrant backgrounds
  var q = [
    {x:X0+W/2,y:Y0,t:"우선 대응 영역",f:0.10},
    {x:X0,y:Y0,t:"저확률·고영향 위험",f:0.06},
    {x:X0+W/2,y:Y0+W/2,t:"점진적 적응 영역",f:0.04},
    {x:X0,y:Y0+W/2,t:"재검토 영역",f:0.02}
  ];
  q.forEach(function(r){ s+='<rect x="'+r.x+'" y="'+r.y+'" width="'+W/2+'" height="'+W/2+'" fill="'+ink+'" fill-opacity="'+r.f+'"/>'+
    '<text x="'+(r.x+W/4)+'" y="'+(r.y+18)+'" text-anchor="middle" font-size="13" fill="'+muted+'">'+r.t+'</text>'; });
  for(var k=0;k<=5;k++){
    s+='<line x1="'+(X0+k*cell)+'" y1="'+Y0+'" x2="'+(X0+k*cell)+'" y2="'+(Y0+W)+'" stroke="'+line+'"/>';
    s+='<line x1="'+X0+'" y1="'+(Y0+k*cell)+'" x2="'+(X0+W)+'" y2="'+(Y0+k*cell)+'" stroke="'+line+'"/>';
  }
  s+='<line x1="'+(X0+W/2)+'" y1="'+Y0+'" x2="'+(X0+W/2)+'" y2="'+(Y0+W)+'" stroke="'+muted+'" stroke-width="1.5"/>';
  s+='<line x1="'+X0+'" y1="'+(Y0+W/2)+'" x2="'+(X0+W)+'" y2="'+(Y0+W/2)+'" stroke="'+muted+'" stroke-width="1.5"/>';
  for(var n=1;n<=5;n++){
    s+='<text x="'+(X0+(n-0.5)*cell)+'" y="'+(Y0+W+18)+'" text-anchor="middle" font-size="12" fill="'+muted+'">'+n+'</text>';
    s+='<text x="'+(X0-10)+'" y="'+(Y0+W-(n-0.5)*cell+4)+'" text-anchor="end" font-size="12" fill="'+muted+'">'+n+'</text>';
  }
  s+='<text x="'+(X0+W/2)+'" y="'+(Y0+W+40)+'" text-anchor="middle" font-size="14" fill="'+ink+'">가능성 →</text>';
  s+='<text transform="translate(22 '+(Y0+W/2)+') rotate(-90)" text-anchor="middle" font-size="14" fill="'+ink+'">영향력 →</text>';
  var groups = {};
  S.claims.forEach(function(c){ if(c.p&&c.i){ var key=c.p+"-"+c.i; (groups[key]=groups[key]||[]).push(c); } });
  var offs=[[0,0],[-22,-22],[22,-22],[-22,22],[22,22],[0,-28],[0,28],[-28,0],[28,0]];
  Object.keys(groups).forEach(function(key){
    groups[key].forEach(function(c,j){
      var o = offs[j%offs.length], cx = X0+(c.p-0.5)*cell+(groups[key].length>1?o[0]:0), cy = Y0+W-(c.i-0.5)*cell+(groups[key].length>1?o[1]:0);
      var fill = c.side==="doom"?doom:hope;
      s+='<g><title>'+esc(label(c)+" "+c.text)+'</title><circle cx="'+cx+'" cy="'+cy+'" r="14" fill="'+fill+'"/>'+
        '<text x="'+cx+'" y="'+(cy+4)+'" text-anchor="middle" font-size="11" font-weight="700" fill="#fff">'+label(c)+'</text></g>';
    });
  });
  return s+'</svg>';
}

