  '<div class="card">'+
  ta("q3","입장 변화(또는 유지)의 근거")+
  ta("q4","향후 10년간 AI가 본인의 전공·진로에 미칠 주요 영향")+
  ta("q5","이에 대한 본인의 대응 방안")+'</div>'+
  '<div class="card">'+ta("s1","입장 요약: AI의 사회적 영향에 대한 본인의 입장과 핵심 근거 (2~3문장)")+'</div>'+
  '<div class="card"><p class="hint" style="margin:0">작성을 마치면 \'저장·내보내기\'에서 PDF로 저장하여 제출합니다. 이름·학번과 조 이름 입력 여부를 확인합니다.</p></div>';
};

function chipW(t){ var w=0; for(var k=0;k<t.length;k++){ w += t.charCodeAt(k)>255 ? 1.05 : 0.6; } return Math.max(3, w+0.6).toFixed(1)+"em"; }
function renameType(k, name){
  var old = S.types[k]; name = (name||"").trim();
  if(old===undefined || !name || name===old){ render(true); return; }
  var dup = S.types.indexOf(name);
  S.claims.forEach(function(c){ if(c.type===old) c.type=name; });
  if(dup>=0){ S.types.splice(k,1); toast("'"+old+"'을(를) '"+name+"'에 합쳤습니다"); }
  else { S.types[k]=name; }
  save(); render(true);
}
function head(t,p){ return '<div class="step-head"><h2>'+t+'</h2>'+(p?'<p>'+p+'</p>':'')+'</div>'; }
function opt(v,txt,cur){ return '<option value="'+esc(v)+'"'+(v===cur?' selected':'')+'>'+esc(txt)+'</option>'; }

/* ---------- render ---------- */
var main = document.getElementById("main");
function renderNav(){
  var nav=document.getElementById("steps"); nav.hidden = !MODE;
  nav.innerHTML = STEPS.map(function(s,k){
    return '<button data-act="go" data-k="'+k+'" class="'+(k===S.step?'on':'')+'">'+esc(s.t)+(s.min?'<span class="m">'+s.min+'분</span>':'')+'</button>';
  }).join("");
}
function render(keepScroll){
  var y = window.scrollY;
  var st = STEPS[S.step];
  var prev = S.step>0 ? '<button class="btn" data-act="go" data-k="'+(S.step-1)+'">← '+esc(STEPS[S.step-1].t)+'</button>' : '<span></span>';
  var next = S.step<STEPS.length-1 ? '<button class="btn primary" data-act="go" data-k="'+(S.step+1)+'">'+esc(STEPS[S.step+1].t)+' →</button>' : '<span></span>';
  main.innerHTML = R[st.id]() + '<div class="navfoot">'+prev+next+'</div>';
  renderNav();
  if(keepScroll) window.scrollTo(0,y);
}

/* ---------- binding ---------- */
function setPath(path, val){
  var parts = path.split("."), o = S;
  for(var k=0;k<parts.length-1;k++){ o = o[parts[k]]; }
  o[parts[parts.length-1]] = val;
}
document.addEventListener("input", function(e){
  var el = e.target;
  if(el.id==="group"){ S.group = el.value; save(); return; }
  if(el.id==="pname"){ S.name = el.value; save(); return; }
  if(el.classList && el.classList.contains("chip-in")){ el.style.width = chipW(el.value); return; }
  if(el.dataset.bind){
    var v = el.dataset.num ? Number(el.value) : el.value;
    setPath(el.dataset.bind, v); save();
    if(el.dataset.num){ var out=document.getElementById("o-"+el.dataset.bind.split(".").pop()); if(out) out.textContent=v; }
  } else if(el.dataset.claim && el.tagName!=="SELECT"){
    var c = findClaim(el.dataset.claim); if(c){ c[el.dataset.field] = el.value; save(); }
  }
});
document.addEventListener("keydown", function(e){
  if(e.key==="Enter" && e.target.classList && e.target.classList.contains("chip-in")){ e.preventDefault(); e.target.blur(); }
  if(e.key==="Escape" && e.target.classList && e.target.classList.contains("chip-in")){ e.target.value = S.types[Number(e.target.dataset.typeK)]||""; e.target.blur(); }
});
document.addEventListener("change", function(e){
  var el = e.target;
  if(el.classList && el.classList.contains("chip-in")){ renameType(Number(el.dataset.typeK), el.value); return; }
  if(el.tagName==="SELECT" && el.dataset.claim){
    var c = findClaim(el.dataset.claim); if(c){ c[el.dataset.field] = el.value; save(); render(true); }
  } else if(el.tagName==="SELECT" && el.dataset.bind){
    setPath(el.dataset.bind, el.value); save();
  } else if(el.id==="critSel" && el.value){
    var add = CRITERIA[el.value].filter(function(t){return S.types.indexOf(t)<0;});
    S.types = S.types.concat(add); S.criterion = el.value; save(); render(true);
    toast(el.value+" 유형 "+add.length+"개를 추가했습니다");
  } else if(el.id==="importFile" && el.files[0]){
    var fr = new FileReader();
    fr.onload = function(){
      try{
        var d = JSON.parse(fr.result);
        if(!d || !Array.isArray(d.claims)) throw new Error("형식 오류");
        if(d.mode && d.mode!==MODE){ toast((d.mode==="group"?"조":"개인")+" 기록 파일입니다. 상단에서 모드를 전환한 뒤 불러옵니다"); el.value=""; return; }
        S = normalize(Object.assign(fresh(), d)); S.mode=MODE; MEM[MODE]=S; save(); syncHeader(); render(); toast("기록을 불러왔습니다");
      }catch(err){ toast("불러올 수 없는 파일입니다"); }
      el.value="";
    };
    fr.readAsText(el.files[0]);
    document.getElementById("menu").open=false;
  }
});
/* adding types and claims: plain buttons + Enter, no form submission (blocked in sandboxed previews) */
function addType(){
  var inp = main.querySelector('#typeForm input[name="t"]'); if(!inp) return;
  var t = inp.value.trim();
  if(!t){ inp.focus(); return; }
  if(S.types.indexOf(t)>=0){ toast("이미 있는 유형입니다"); inp.select(); return; }
  S.types.push(t); save(); render(true);
  var again = main.querySelector('#typeForm input[name="t"]'); if(again) again.focus();
}
function addClaim(side){
  var box = main.querySelector('.add[data-side="'+side+'"]'); if(!box) return;
  var ti = box.querySelector('input[name="text"]'), bi = box.querySelector('input[name="basis"]');
  var text = ti.value.trim();
  if(!text){ ti.focus(); return; }
  S.claims.push({id:uid(), side:side, text:text, basis:bi.value.trim(), type:"", p:0, i:0, note:"", ex:false});
  save(); render(true);
  var again = main.querySelector('.add[data-side="'+side+'"] input[name="text"]'); if(again) again.focus();
}
document.addEventListener("keydown", function(e){
  var el = e.target; if(e.key!=="Enter" || e.isComposing || e.keyCode===229 || !el.dataset || !el.dataset.enter) return;
  e.preventDefault();
  if(el.dataset.enter==="type") addType(); else addClaim(el.dataset.side);
});
document.addEventListener("click", function(e){
  var b = e.target.closest("[data-act]"); if(!b) return;
  var a = b.dataset.act;
  if(a==="type-add"){ addType(); return; }
  if(a==="claim-add"){ addClaim(b.dataset.side); return; }
  if(a==="mode"){ if(b.dataset.m!==MODE){ setMode(b.dataset.m); toast((MODE==="personal"?"개인":"조")+" 기록으로 바꿨습니다"); } return; }
  if(a==="go"){ S.step = Number(b.dataset.k); save(); render(); window.scrollTo(0,0); if(!running) resetTimer(); }
  else if(a==="claim-del"){ var c=findClaim(b.dataset.id); if(c){ var at=S.claims.indexOf(c); S.claims.splice(at,1); save(); render(true);
      toast("주장을 삭제했습니다", "되돌리기", function(){ S.claims.splice(Math.min(at,S.claims.length),0,c); save(); render(true); }); } }
  else if(a==="type-del"){ var t=S.types[Number(b.dataset.k)]; S.types.splice(Number(b.dataset.k),1); S.claims.forEach(function(c){ if(c.type===t) c.type=""; }); save(); render(true); }
  else if(a==="score"){ var c2=findClaim(b.dataset.id); var v=Number(b.dataset.v); c2[b.dataset.f] = c2[b.dataset.f]===v?0:v; save(); render(true); }
  else if(a==="area-add"){ S.areas.push({name:"",change:"",mine:"",fixed:false}); save(); render(true); }
  else if(a==="area-del"){ S.areas.splice(Number(b.dataset.k),1); save(); render(true); }
  else if(a==="export-json"){ download(fname("json"), JSON.stringify(S,null,2), "application/json"); closeMenu(); }
  else if(a==="export-csv"){ exportCsv(); closeMenu(); }
  else if(a==="print"){ closeMenu(); window.print(); }
  else if(a==="reset"){
    if(b.dataset.armed!=="1"){ b.dataset.armed="1"; b.textContent="한 번 더 누르면 이 모드의 기록이 모두 지워집니다"; setTimeout(function(){ b.dataset.armed=""; b.textContent="처음부터 다시 시작"; },4000); return; }
    b.dataset.armed=""; b.textContent="처음부터 다시 시작"; closeMenu(); S=fresh(); S.mode=MODE; MEM[MODE]=S; save(); syncHeader(); render(); resetTimer(); toast("기록을 지웠습니다"); }
});
function closeMenu(){ document.getElementById("menu").open=false; }
function fname(ext){ var d=new Date(); var p=function(n){return String(n).padStart(2,"0");}; var who = MODE==="personal" ? "개인_"+(S.group||"조")+"_"+(S.name||"이름") : "조_"+(S.group||"조"); return ("AI토론_"+who+"_").replace(/[\\/:*?"<>|\s]+/g,"_")+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+"."+ext; }
function download(name, text, type){
  var blob = new Blob([(type==="text/csv"?"\ufeff":"")+text], {type:type+";charset=utf-8"});
  var a = document.createElement("a"); a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click(); setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); },500);
}
function exportCsv(){
  var q = function(s){ return '"'+String(s==null?"":s).replace(/"/g,'""')+'"'; };
  var rows = [["조","번호","관점","주장","근거","유형","가능성","영향력","메모"].map(q).join(",")];
  S.claims.forEach(function(c){ rows.push([S.group,label(c),c.side==="doom"?"비관":"낙관",c.text,c.basis,c.type,c.p||"",c.i||"",c.note].map(q).join(",")); });
  download(fname("csv"), rows.join("\r\n"), "text/csv");
}

/* print all steps */
window.addEventListener("beforeprint", function(){
  var cur = S.step, html = '<h1 style="font-size:20px">AI와 우리의 미래 · '+(MODE==="personal"?'개인 기록 · '+esc(S.name||"이름 미기재")+' · ':'조 기록 · ')+esc(S.group||"조 미기재")+'</h1>'+(MODE==="group"&&S.members?'<p>조원: '+esc(S.members)+'</p>':'');
  for(var k=1;k<STEPS.length;k++){ S.step=k; html += '<section class="pstep">'+R[STEPS[k].id]()+'</section>'; }
  S.step = cur;
  var pa = document.getElementById("printArea"); pa.innerHTML = html;
  pa.querySelectorAll("textarea").forEach(function(t){ var d=document.createElement("div"); d.style.whiteSpace="pre-wrap"; d.style.minHeight="1.4em"; d.textContent=t.value; t.replaceWith(d); });
});

/* ---------- timer ---------- */
var remain=0, running=false, tick=null;
var tdisp=document.getElementById("tdisp"), tstart=document.getElementById("tstart"), timerEl=document.getElementById("timer");
function fmt(s){ var m=Math.floor(Math.abs(s)/60), x=Math.abs(s)%60; return (s<0?"-":"")+String(m).padStart(2,"0")+":"+String(x).padStart(2,"0"); }
function paint(){ tdisp.textContent=fmt(remain); timerEl.classList.toggle("done", remain<=0 && STEPS[S.step] && STEPS[S.step].min>0); tstart.textContent=running?"일시정지":"시작"; }
function resetTimer(){ running=false; clearInterval(tick); remain=(STEPS[S.step]?STEPS[S.step].min:0)*60; paint(); }
tstart.addEventListener("click", function(){
  if(running){ running=false; clearInterval(tick); }
  else { running=true; tick=setInterval(function(){ remain--; if(remain===0) toast("시간이 끝났습니다"); paint(); },1000); }
  paint();
});
document.getElementById("treset").addEventListener("click", resetTimer);

function syncHeader(){
  document.getElementById("group").value = S.group||"";
  document.getElementById("pname").value = S.name||"";
  document.getElementById("nameWrap").hidden = MODE!=="personal";
  document.getElementById("csvBtn").hidden = MODE!=="group";
  document.getElementById("timer").hidden = !MODE;
  document.getElementById("group").parentNode.hidden = !MODE;
  document.getElementById("menu").hidden = !MODE;
  var seg=document.getElementById("modeSeg"); seg.hidden=!MODE;
  seg.querySelectorAll("button").forEach(function(x){ var on = x.dataset.m===MODE; x.classList.toggle("on",on); x.setAttribute("aria-pressed",on?"true":"false"); });
  document.querySelector(".brand .sub").textContent = MODE==="personal"?"개인 기록 · 1. 도입, 7. 성찰":MODE==="group"?"조 기록 · 2~6단계":"비관론과 낙관론 토론 활동";
}

var saved=null; try{ saved=localStorage.getItem(MODE_KEY); }catch(e){}
setMode(saved);
})();
</script>
