<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI와 우리의 미래</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f4ef; --panel:#ffffff; --ink:#1d1f24; --muted:#6b6f78; --line:#e2ded5;
  --accent:#2f5d8a; --accent-soft:#e6eef6;
  --doom:#c8455b; --doom-soft:#fbe9ec;
  --hope:#c98a00; --hope-soft:#fdf3d6;
  --ok:#2e7d5b; --radius:12px;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#16181d; --panel:#1f2228; --ink:#eceae4; --muted:#9ca1ab; --line:#33373f;
    --accent:#7fb0e0; --accent-soft:#22303f;
    --doom:#ec7d8f; --doom-soft:#3a2328;
    --hope:#f0bf4a; --hope-soft:#3a3220;
    --ok:#6cc59c;
  }
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:"Noto Sans KR",system-ui,-apple-system,sans-serif;font-size:16px;line-height:1.6}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
h1,h2,h3{line-height:1.3;margin:0}

/* header */
.top{position:sticky;top:0;z-index:20;background:var(--panel);border-bottom:1px solid var(--line);padding:10px 16px;display:flex;flex-wrap:wrap;gap:10px 20px;align-items:center;justify-content:space-between}
.brand h1{font-size:19px}
.brand .sub{font-size:13px;color:var(--muted)}
.tools{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.group-in{display:flex;align-items:center;gap:6px;font-size:14px;color:var(--muted)}
.group-in input{width:110px;padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
.timer{display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:3px 4px 3px 12px}
.timer #tdisp{font-variant-numeric:tabular-nums;font-weight:700;min-width:52px}
.timer.done #tdisp{color:var(--doom)}
.timer button{border:none;background:var(--accent);color:#fff;border-radius:999px;padding:4px 12px;font-size:13px}
.timer button.ghost{background:transparent;color:var(--muted);padding:4px 8px}
.menu{position:relative}
.menu summary{list-style:none;cursor:pointer;padding:6px 12px;border:1px solid var(--line);border-radius:8px;font-size:14px}
.menu summary::-webkit-details-marker{display:none}
.menu[open] .menu-body{display:flex}
.menu-body{display:none;position:absolute;right:0;top:calc(100% + 6px);flex-direction:column;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:6px;min-width:190px;box-shadow:0 8px 24px rgba(0,0,0,.12)}
.menu-body button,.menu-body label{display:block;text-align:left;border:none;background:none;padding:8px 10px;border-radius:6px;font-size:14px;cursor:pointer}
.menu-body button:hover,.menu-body label:hover{background:var(--accent-soft)}
.menu-body .danger{color:var(--doom)}

/* step nav */
nav#steps{display:flex;gap:6px;overflow-x:auto;padding:10px 16px;border-bottom:1px solid var(--line);background:var(--bg);position:sticky;top:57px;z-index:15;scrollbar-width:thin}
nav#steps button{flex:0 0 auto;border:1px solid var(--line);background:var(--panel);border-radius:999px;padding:6px 14px;font-size:14px;white-space:nowrap}
nav#steps button.on{background:var(--accent);border-color:var(--accent);color:#fff}
nav#steps button .m{opacity:.7;font-size:12px;margin-left:4px}
@media (max-width:720px){ .top{position:static} nav#steps{top:0} }
.seg{display:inline-flex;border:1px solid var(--accent);border-radius:999px;overflow:hidden}
.seg button{border:none;background:var(--panel);color:var(--accent);padding:6px 14px;font-size:14px;font-weight:700}
.seg button.on{background:var(--accent);color:#fff}
.choose{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:720px){.choose{grid-template-columns:1fr}}
.choose button{text-align:left;background:var(--panel);border:2px solid var(--line);border-radius:var(--radius);padding:20px}
.choose button:hover{border-color:var(--accent)}
.choose b{display:block;font-size:20px;margin-bottom:4px}
.choose .who{color:var(--accent);font-weight:700;font-size:14px}
tr.here td{background:var(--accent-soft)}

main{max-width:1080px;margin:0 auto;padding:20px 16px 60px}
.step-head{margin-bottom:16px}
.step-head h2{font-size:24px}
.step-head p{margin:6px 0 0;color:var(--muted)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-bottom:16px}
.card h3{font-size:17px;margin-bottom:10px}
.hint{font-size:14px;color:var(--muted)}
.pill{display:inline-block;font-size:12px;padding:1px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-weight:500}

table{width:100%;border-collapse:collapse;font-size:15px}
th,td{border-bottom:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}
th{font-size:13px;color:var(--muted);font-weight:500}
.tbl-wrap{overflow-x:auto}
td input,td textarea,td select{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}
textarea{resize:vertical;min-height:40px}
.field{display:block;margin-bottom:12px}
.field span{display:block;font-size:14px;font-weight:500;margin-bottom:4px}
.field input,.field textarea{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg)}

.btn{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:7px 14px;font-size:14px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.sm{padding:3px 9px;font-size:13px}
.navfoot{display:flex;justify-content:space-between;margin-top:20px}

/* brainstorm */
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media (max-width:720px){.cols{grid-template-columns:1fr}}
.col{border-radius:var(--radius);padding:14px;border:1px solid var(--line)}
.col.doom{background:var(--doom-soft)}
.col.hope{background:var(--hope-soft)}
.col h3{display:flex;align-items:center;gap:8px}
.col.doom h3{color:var(--doom)}
.col.hope h3{color:var(--hope)}
.col .quote{font-size:13px;color:var(--muted);margin:-6px 0 10px}
.add{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}
.add input{padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
.add .row{display:flex;gap:6px}
.add .row input{flex:1}
.claim{background:var(--panel);border:1px solid var(--line);border-left:4px solid var(--c);border-radius:10px;padding:10px 12px;margin-bottom:8px;position:relative}
.claim.doom{--c:var(--doom)} .claim.hope{--c:var(--hope)}
.claim .num{font-size:12px;font-weight:700;color:var(--c)}
.claim .txt{font-weight:500}
.claim .basis{font-size:14px;color:var(--muted)}
.claim .x{position:absolute;top:6px;right:6px;border:none;background:none;color:var(--muted);font-size:16px;line-height:1;padding:4px}
.claim .x:hover{color:var(--doom)}
.claim .meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;align-items:center}
.claim select{padding:3px 6px;border:1px solid var(--line);border-radius:6px;background:var(--bg);font-size:13px}
.counter{font-size:13px;color:var(--muted)}

/* classify */
.types{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.chip{display:inline-flex;align-items:center;gap:4px;background:var(--accent-soft);color:var(--accent);border-radius:999px;padding:4px 6px 4px 12px;font-size:14px}
.chip-in{border:none;background:transparent;color:inherit;font:inherit;padding:0;min-width:3em;border-bottom:1px dashed transparent}
.chip-in:hover,.chip-in:focus{border-bottom-color:currentColor;outline:none}
.chip button{border:none;background:none;color:inherit;padding:0 4px;font-size:15px;line-height:1}
.board{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.bucket{background:var(--bg);border:1px dashed var(--line);border-radius:var(--radius);padding:10px}
.bucket h4{margin:0 0 8px;font-size:15px;display:flex;justify-content:space-between;align-items:center;gap:6px}
.bucket.hot{border:2px solid var(--accent);background:var(--accent-soft)}
.hotbadge{font-size:11px;background:var(--accent);color:#fff;border-radius:999px;padding:1px 8px;font-weight:500}
.bucket .claim{margin-bottom:6px;padding:8px 10px}

/* rate */
.rate-row{display:grid;grid-template-columns:1fr auto auto;gap:10px 18px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
@media (max-width:720px){.rate-row{grid-template-columns:1fr}}
.scale{display:flex;align-items:center;gap:4px}
.scale .lbl{font-size:12px;color:var(--muted);width:44px}
.scale button{width:32px;height:32px;border-radius:8px;border:1px solid var(--line);background:var(--panel);font-weight:700;font-size:14px}
.scale button.on{background:var(--c,var(--accent));border-color:var(--c,var(--accent));color:#fff}
.rate-row.doom{--c:var(--doom)} .rate-row.hope{--c:var(--hope)}
.rate-row .note{grid-column:1/-1}
.rate-row .note input{width:100%;padding:6px 8px;border:1px solid var(--line);border-radius:8px;background:var(--bg);font-size:14px}
.progress{height:6px;background:var(--line);border-radius:999px;overflow:hidden;margin-top:6px}
.progress div{height:100%;background:var(--accent)}

/* quadrant */
.quad-wrap{display:grid;grid-template-columns:minmax(0,560px) 1fr;gap:16px;align-items:start}
@media (max-width:860px){.quad-wrap{grid-template-columns:1fr}}
svg.quad{width:100%;height:auto;display:block}
.legend{font-size:14px;max-height:520px;overflow:auto}
.legend li{margin-bottom:6px}
.legend .tag{display:inline-block;min-width:34px;text-align:center;border-radius:6px;color:#fff;font-size:12px;font-weight:700;padding:1px 4px;margin-right:6px}
.legend ol{list-style:none;padding:0;margin:0}

/* reflect */
.range{display:flex;align-items:center;gap:10px}
.range input{flex:1}
.range output{font-weight:700;width:28px;text-align:center}
.sentence{font-size:17px;line-height:2.2}
.sentence input{border:none;border-bottom:2px solid var(--accent);background:transparent;padding:2px 6px;width:min(320px,100%)}

.tip li{margin-bottom:6px}
footer{text-align:center;font-size:13px;color:var(--muted);padding:20px 16px 40px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:999px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:50}
.toast.show{opacity:1;pointer-events:auto}
.toast-act{margin-left:12px;border:none;background:none;color:var(--accent-soft);font-weight:700;text-decoration:underline;padding:0}

#printArea{display:none}
@media print{
  .top,nav#steps,footer,main,.toast{display:none!important}
  #printArea{display:block;padding:0 8mm}
  body{background:#fff;color:#000}
  .card,.col,.bucket{break-inside:avoid}
  .pstep{break-before:page}
  .pstep:first-child{break-before:auto}
  button,.add{display:none!important}
}
</style>
</head>
<body>
<header class="top">
  <div class="brand"><h1>AI와 우리의 미래</h1><div class="sub">비관론과 낙관론 조별 토론 활동</div></div>
  <div class="tools">
    <div class="seg" id="modeSeg" role="group" aria-label="기록 모드" hidden><button data-act="mode" data-m="personal">개인 기록</button><button data-act="mode" data-m="group">조 기록</button></div>
    <label class="group-in" id="nameWrap">이름 <input id="pname" placeholder="이름·학번" aria-label="이름과 학번"></label>
    <label class="group-in">조 <input id="group" placeholder="조 이름" aria-label="조 이름"></label>
    <div class="timer" id="timer"><span id="tdisp">00:00</span><button id="tstart">시작</button><button id="treset" class="ghost" title="시간 초기화">↺</button></div>
    <details class="menu" id="menu">
      <summary>저장·내보내기</summary>
      <div class="menu-body">
        <button data-act="export-json">기록 파일로 저장 (JSON)</button>
        <label>기록 파일 불러오기<input type="file" id="importFile" accept=".json,application/json" hidden></label>
        <button data-act="export-csv" id="csvBtn">주장 표 내보내기 (CSV)</button>
        <button data-act="print">전체 인쇄 / PDF</button>
        <button data-act="reset" class="danger">처음부터 다시 시작</button>
      </div>
    </details>
  </div>
</header>
<nav id="steps" aria-label="활동 단계"></nav>
<main id="main"></main>
<div id="printArea"></div>
<footer>기록은 현재 브라우저에 자동 저장됩니다. 제출 또는 기기 간 이동 시 '저장·내보내기'를 사용합니다.</footer>
<div class="toast" id="toast"></div>

<script>
(function(){
"use strict";
var MODE_KEY = "ai-future-mode";
var KEYS = {personal:"ai-future-personal-v1", group:"ai-future-group-v1"};
var DEF = {
  overview:{t:"개요", min:0},
  intro:{t:"1. 도입", min:5, who:"개인"},
  areas:{t:"2. 사회 영역", min:5, who:"조"},
  brain:{t:"3. 브레인스토밍", min:10, who:"조"},
  classify:{t:"4. 유형 분류", min:7, who:"조"},
  rate:{t:"5. 가능성 평가", min:10, who:"조"},
  discuss:{t:"6. 사분면·자유토론", min:8, who:"조"},
  reflect:{t:"7. 성찰", min:5, who:"개인"}
};
var ORDER = ["intro","areas","brain","classify","rate","discuss","reflect"];
var MODE_STEPS = {personal:["overview","intro","reflect"], group:["overview","areas","brain","classify","rate","discuss"]};
var MODE = null, KEY = null, STEPS = [], MEM = {};
function stepList(m){ return (MODE_STEPS[m]||["choose"]).map(function(id){ return id==="choose" ? {id:"choose",t:"시작",min:0} : {id:id,t:DEF[id].t,min:DEF[id].min}; }); }

var CRITERIA = {
  "영역별": ["경제·노동","정보·정치","과학·의료","교육","개인·관계","안전·통제"],
  "시기별": ["이미 일어나는 일","5년 내","장기(20년 이상)"],
  "원인별": ["기술 자체의 문제","사람의 오용","제도·분배의 문제"],
  "성격별": ["사실에 기반","추세에 기반한 예측","가정에 기반한 시나리오"]
};

function uid(){ return Math.random().toString(36).slice(2,9); }

function fresh(){
  return {
    step:0, group:"", name:"", members:"", mode:MODE,
    intro:[
      {time:"학업·업무", text:"", mark:""},
      {time:"정보·소통", text:"", mark:""},
      {time:"일상·여가", text:"", mark:""}
    ],
    introTalk:"",
    areas:[
      {name:"일과 직업", change:"번역·코딩·디자인·상담 등 사무직 업무 일부를 AI가 수행", mine:"", fixed:true},
      {name:"교육과 배움", change:"AI 튜터, 과제 대필 논란, 평가 방식 변화", mine:"", fixed:true},
      {name:"정보와 민주주의", change:"딥페이크, 허위정보 대량 생산, 추천 알고리즘의 확증편향", mine:"", fixed:true},
      {name:"과학과 건강", change:"신약 개발, 단백질 구조 예측, 의료 영상 진단", mine:"", fixed:true},
      {name:"관계와 정서", change:"AI 동반자·상담 서비스, 정서적 지원과 의존의 문제", mine:"", fixed:true},
      {name:"", change:"", mine:"", fixed:false}
    ],
    claims:[
      {id:uid(), side:"doom", text:"사무·전문직의 대량 실업과 불평등 심화", basis:"AI가 번역·코딩·문서 작업을 수행하고, 이익이 소수 기업에 집중", type:"", p:0, i:0, note:"", ex:true},
      {id:uid(), side:"doom", text:"딥페이크·허위정보로 인한 신뢰 붕괴", basis:"누구나 저비용으로 가짜 영상·글을 대량 생산 가능", type:"", p:0, i:0, note:"", ex:true},
      {id:uid(), side:"hope", text:"과학·의료 혁신의 가속", basis:"알파폴드의 단백질 구조 예측(2024 노벨 화학상), 신약 개발 기간 단축", type:"", p:0, i:0, note:"", ex:true},
      {id:uid(), side:"hope", text:"새로운 직업과 생산성 향상", basis:"산업혁명·컴퓨터도 일자리를 없앴지만 더 많은 새 직업을 만듦", type:"", p:0, i:0, note:"", ex:true}
    ],
    criterion:"",
    types:[],
    discussNote:"",
    reflect:{before:5, after:5, q1:"", q2:"", q3:"", q4:"", q5:"", s1:"", s2:""}
  };
}

var INTRO_PH = [
  "예: 생성형 AI로 문헌 요약·번역, 코딩 보조, 과제 초안 검토",
  "예: 검색 결과·뉴스 피드 추천, 자동 번역, SNS 콘텐츠 필터링",
  "예: 영상·음악 추천, 지도 경로 안내, 쇼핑 추천, 사진 자동 보정"
];
var S;
function normalize(st){
  var f = fresh();
  var oldIntro = Array.isArray(st.intro) ? st.intro : [];
  st.intro = f.intro.map(function(r,k){ var o = oldIntro[k]||{}; return {time:r.time, text:o.text||"", mark:o.mark||""}; });
  var oldAreas = Array.isArray(st.areas) ? st.areas : [];
  var oldFixed = oldAreas.filter(function(a){ return a && a.fixed; });
  var custom = oldAreas.filter(function(a){ return a && !a.fixed; });
  st.areas = f.areas.filter(function(a){ return a.fixed; }).map(function(a,k){
    return {name:a.name, change:a.change, mine:(oldFixed[k]&&oldFixed[k].mine)||"", fixed:true};
  }).concat(custom.length ? custom : f.areas.filter(function(a){ return !a.fixed; }));
  return st;
}
function load(){
  if(!KEY){ S = fresh(); return; }
  if(MEM[MODE]){ S = MEM[MODE]; return; }
  try{
    var raw = localStorage.getItem(KEY);
    if(raw){ var d = JSON.parse(raw); if(d && Array.isArray(d.claims)){ S = normalize(Object.assign(fresh(), d)); return; } }
  }catch(e){}
  S = fresh();
}
var saveT;
function save(){
  clearTimeout(saveT);
  if(!KEY) return;
  saveT = setTimeout(function(){ try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){} }, 200);
}
function setMode(m){
  clearTimeout(saveT);
  if(KEY){ MEM[MODE] = S; try{ localStorage.setItem(KEY, JSON.stringify(S)); }catch(e){} }
  MODE = (m==="personal"||m==="group") ? m : null;
  KEY = MODE ? KEYS[MODE] : null;
  STEPS = stepList(MODE);
  try{ if(MODE) localStorage.setItem(MODE_KEY, MODE); else localStorage.removeItem(MODE_KEY); }catch(e){}
  load(); S.mode = MODE;
  if(S.step >= STEPS.length) S.step = 0;
  syncHeader(); render(); resetTimer(); window.scrollTo(0,0);
}

function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];}); }
var toastT;
function toast(msg, act, fn){
  var t=document.getElementById("toast"); t.textContent=msg;
  if(act){ var bt=document.createElement("button"); bt.textContent=act; bt.className="toast-act"; bt.onclick=function(){ fn(); t.classList.remove("show"); }; t.appendChild(bt); }
  t.classList.add("show"); clearTimeout(toastT); toastT=setTimeout(function(){t.classList.remove("show");}, act?5000:1800);
}

function sideClaims(side){ return S.claims.filter(function(c){return c.side===side;}); }
function label(c){
  var list = sideClaims(c.side);
  return (c.side==="doom"?"비":"낙") + (list.indexOf(c)+1);
}
